# ─── App ───
APP_NAME=IndaureX SaaS Platform
DEBUG=true

# ─── Database ───
DATABASE_URL=postgresql://indaurex:indaurex_secret@localhost:5432/indaurex_db

# ─── JWT ───
JWT_SECRET_KEY=change-me-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Encryption (Fernet) ───
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_SECRET_KEY=change-me-generate-with-fernet

# ─── Webhook ───
WEBHOOK_BASE_URL=http://localhost:8000/v1/twilio/webhook
